<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Night (dark) window theme. Its mere existence makes Theme.DotSuite a DayNight theme, so in system
      dark mode the window resolves as isLightTheme=false. Extended/auto dark features decide to invert
      an app based on it looking light-only in dark mode; a genuinely dark-aware theme removes that
      trigger, so the OS stops force-inverting us and Compose/DotSuiteTheme controls the real colors
      (including honouring an in-app "Light" choice while the device itself is dark).
    -->
    <style name="Theme.DotSuite" parent="android:Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#080808</item>
    </style>
</resources>
